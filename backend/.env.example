
# ==========================================
# Django Configuration
# ==========================================
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Frontend CORS Configuration
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ==========================================
# OpenRouteService - Routing API
# ==========================================
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org

# ==========================================
# OpenStreetMap / Nominatim - Geocoding
# ==========================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=WeatherAwareTruckRouting/1.0 (contact: your-email@example.com)

# ==========================================
# Open-Meteo - Weather Forecast API
# ==========================================
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ==========================================
# External API Configuration
# ==========================================
EXTERNAL_API_TIMEOUT_SECONDS=15

# Optional: live traffic layer on the map (free key at https://developer.tomtom.com)
TOMTOM_API_KEY=
